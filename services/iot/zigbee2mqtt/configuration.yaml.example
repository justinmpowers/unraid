# configuration.yaml.example - Template file (safe to commit to git)
# The real configuration.yaml lives outside this repo, in
# ${HOME_ASSISTANT_PATH}/zigbee2mqtt/configuration.yaml (bind-mounted to
# /app/data in the container). It contains the Zigbee network_key and
# pan_id, so it is intentionally NOT tracked here. Copy the relevant
# settings below over by hand when standing up a new instance or
# migrating to new adapter hardware.

homeassistant:
  enabled: true

mqtt:
  base_topic: zigbee2mqtt
  server: mqtt://<mqtt-host>:1883

serial:
  port: /dev/ttyZBT2
  adapter: ember

frontend:
  enabled: true
  port: 8080

advanced:
  network_key: GENERATE
  pan_id: GENERATE
