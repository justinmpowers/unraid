# Music Assistant server configuration
# Copy this to .env and adjust values, or rely on the shared root .env when
# deploying with `--env-file ../../../.env`.

# Shared variables (normally provided by the root .env)
TZ=US/Eastern
APPDATA_PATH=/mnt/user/appdata

# Log level: debug | info | warning | error
MUSIC_ASSISTANT_LOG_LEVEL=info
