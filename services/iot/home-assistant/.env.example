# Home Assistant / Matter Server / Wyoming Whisper+Piper stack configuration
# Copy this to .env and adjust values

TZ=US/Eastern
HOME_ASSISTANT_PATH=/mnt/user/appdata/home-assistant

# Base domain used for the Traefik router, e.g. homeassistant.example.com
DOMAIN=example.com

# Whisper (speech-to-text) model, CPU-only. tiny-int8 is fastest; bump to
# base-int8/small-int8 for better accuracy if you have the CPU headroom.
WHISPER_MODEL=tiny-int8
WHISPER_LANGUAGE=en

# Piper (text-to-speech) voice. Browse more at https://rhasspy.github.io/piper-samples/
PIPER_VOICE=en_US-lessac-medium
