# Home Assistant / Matter Server / ESPHome Dashboard stack configuration
# Copy this to .env and adjust values

TZ=US/Eastern
HOME_ASSISTANT_PATH=/mnt/user/appdata/home-assistant

# Base domain used for the Traefik router, e.g. homeassistant.example.com
DOMAIN=example.com

# Static LAN IP of the Unraid host. home-assistant, matter-server, and esphome
# all run on network_mode: host (required for mDNS discovery of ESPHome/HomeKit
# devices and, for home-assistant, OTA flashing/adoption), so none of them can
# be reached via Docker network discovery. This IP is used for their Uptime
# Kuma health checks, for reaching the ESPHome dashboard directly, and must
# also be pasted into Traefik's dynamic.yml file provider config for
# home-assistant - see README.md in this directory.
UNRAID_HOST_IP=192.168.1.10

# Optional login for the ESPHome Dashboard (leave blank to disable auth)
ESPHOME_USERNAME=
ESPHOME_PASSWORD=
