# Home Assistant / Matter Server / ESPHome Dashboard stack configuration
# Copy this to .env and adjust values

TZ=US/Eastern
HOME_ASSISTANT_PATH=/mnt/user/appdata/home-assistant

# Base domain used for the Traefik router, e.g. homeassistant.example.com
DOMAIN=example.com

# Static LAN IP of the Unraid host. matter-server and esphome run on
# network_mode: host (required for mDNS device discovery/adoption), so they
# can't be reached via Docker network discovery. This IP is used for the
# esphome Uptime Kuma health check and to reach its dashboard directly -
# see README.md in this directory.
UNRAID_HOST_IP=192.168.1.10

# Optional login for the ESPHome Dashboard (leave blank to disable auth)
ESPHOME_USERNAME=
ESPHOME_PASSWORD=
