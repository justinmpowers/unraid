# Home Assistant / Matter Server stack configuration
# Copy this to .env and adjust values

TZ=US/Eastern
HOME_ASSISTANT_PATH=/mnt/user/appdata/home-assistant

# Base domain used for the Traefik router, e.g. homeassistant.example.com
DOMAIN=example.com

# Static LAN IP of the Unraid host. home-assistant runs on network_mode: host
# (required for ESPHome/HomeKit/mDNS discovery), so it can't be reached via
# Docker network discovery. This IP is used for the Uptime Kuma health check
# and must also be pasted into Traefik's dynamic.yml file provider config -
# see README.md in this directory.
UNRAID_HOST_IP=192.168.1.10
