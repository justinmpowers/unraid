# MCP Stack (Internal Only)
# Copy this to .env and adjust values

# Application paths
# APPDATA_PATH must be set, or the gateway's config mount resolves to a
# non-existent path, Docker silently creates an empty directory there, and
# nginx falls back to its stock config on port 80 (healthcheck then fails).
APPDATA_PATH=/mnt/user/appdata

# ============================================
# GATEWAY
# ============================================
# Bearer token every MCP request must present. Must be non-empty: an empty
# value renders the auth check as "Bearer " and every request returns 401.
# Generate with: openssl rand -hex 32
MCP_GATEWAY_TOKEN=your_gateway_token_here

# ============================================
# CORE SERVERS
# ============================================
# Host paths exposed to mcp-filesystem (rw) and mcp-git (ro)
MCP_WORKSPACE_PATH=/mnt/user/appdata/mcp/workspace
MCP_MODELS_PATH=/mnt/user/data/models

# GitHub PAT for mcp-github. Use a read-only, least-privilege token.
MCP_GITHUB_TOKEN=your_github_pat_here

# Primary Postgres endpoint for mcp-postgres. Prefer a read-only role.
MCP_POSTGRES_URL=postgresql://readonly:changeme@postgres:5432/postgres

# ============================================
# PROFILE: postgres-all
# ============================================
# One MCP Postgres endpoint per DB service in this repo.
# Enable with: docker compose --profile postgres-all up -d
MCP_POSTGRES_URL_MANYFOLD=postgresql://readonly:changeme@manyfold-postgres:5432/manyfold
MCP_POSTGRES_URL_AUTHENTIK=postgresql://readonly:changeme@authentik-postgres:5432/authentik
MCP_POSTGRES_URL_TANDOOR=postgresql://readonly:changeme@tandoor-postgres:5432/tandoor
MCP_POSTGRES_URL_WIKIJS=postgresql://readonly:changeme@wikijs-postgres:5432/wikijs
MCP_POSTGRES_URL_NEXTCLOUD=postgresql://readonly:changeme@nextcloud-postgres:5432/nextcloud
MCP_POSTGRES_URL_J3D=postgresql://readonly:changeme@j3d-postgres:5432/j3d

# ============================================
# PROFILE: optional
# ============================================
# Enable with: docker compose --profile optional up -d

# Host directory mounted read-only at /data in mcp-sqlite
MCP_SQLITE_HOST_DIR=/mnt/user/appdata/mcp/sqlite
# Path to the DB file as seen inside the container
MCP_SQLITE_PATH=/data/database.db

# Tavily API key for mcp-search
MCP_TAVILY_API_KEY=your_tavily_api_key_here
