server {
  listen 8080;
  server_name _;

  # proxy_pass below interpolates a variable, so nginx resolves the backend
  # per request rather than at startup and needs an explicit resolver. Without
  # one every proxied request fails with 502 ("no resolver defined to resolve
  # mcp-..."), while /healthz still answers because it never proxies.
  # NGINX_LOCAL_RESOLVERS is exported by the image's 15-local-resolvers.envsh,
  # which only runs when NGINX_ENTRYPOINT_LOCAL_RESOLVERS is set - see the
  # gateway's environment in docker-compose.yml.
  # Per-request resolution is deliberate: a static proxy_pass would make nginx
  # resolve every backend at startup and refuse to start when the `optional`
  # and `postgres-all` profiles are not deployed.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

  location = /healthz {
    return 200 'ok';
    add_header Content-Type text/plain;
  }

  location ~ ^/(filesystem|git|github|postgres|postgres-manyfold|postgres-authentik|postgres-tandoor|postgres-wikijs|postgres-nextcloud|postgres-j3d|fetch|sqlite|docker|playwright|search)/mcp$ {
    if ($http_authorization != "Bearer ${MCP_GATEWAY_TOKEN}") {
      return 401;
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_buffering off;
    proxy_cache off;

    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_pass http://mcp-$1:8000/mcp;
  }
}
