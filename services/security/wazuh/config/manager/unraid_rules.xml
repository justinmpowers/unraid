<!--
  Rules for Unraid webGUI logins (decoder: unraid_decoders.xml). IDs 100600-100699.
  Level 10+ is pushed to ntfy by the custom-ntfy integration.
  Installed to /var/ossec/etc/rules/ by scripts/setup-wazuh.sh.
-->
<group name="unraid,">

  <rule id="100600" level="0">
    <decoded_as>barracuda-svf-admin</decoded_as>
    <program_name>^webGUI$</program_name>
    <field name="unraid.login_result">\.+</field>
    <description>Unraid webGUI login</description>
  </rule>

  <rule id="100601" level="5">
    <if_sid>100600</if_sid>
    <field name="unraid.login_result">^Unsuccessful$</field>
    <description>Unraid webGUI: failed login for $(dstuser) from $(srcip)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100602" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100601</if_matched_sid>
    <same_srcip />
    <description>Unraid webGUI: multiple failed logins from $(srcip)</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100603" level="3">
    <if_sid>100600</if_sid>
    <field name="unraid.login_result">^Successful$</field>
    <description>Unraid webGUI: $(dstuser) logged in from $(srcip)</description>
    <group>authentication_success,</group>
  </rule>

</group>
